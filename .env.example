# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=commercepulse
POSTGRES_USER=cp_user
POSTGRES_PASSWORD=changeme

# ── MinIO (local S3) ──────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BRONZE_BUCKET=cp-bronze
MINIO_SILVER_BUCKET=cp-silver
MINIO_GOLD_BUCKET=cp-gold

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=changeme_generate_with_python_fernet
AIRFLOW__WEBSERVER__SECRET_KEY=changeme

